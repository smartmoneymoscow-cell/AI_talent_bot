# Telegram Bot Token (от @BotFather)
BOT_TOKEN=your_token_here

# URL Mini App (после деплоя, ngrok, или локально)
# Для локальной разработки: http://localhost:8000
# Для продакшена: https://your-domain.com
MINI_APP_URL=http://localhost:8000

# YooKassa (опционально)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Комиссия платформы (%)
PLATFORM_FEE_PERCENT=5

# ID админов через запятую
ADMIN_IDS=

# Путь к базе данных
DB_PATH=data/bot.db
